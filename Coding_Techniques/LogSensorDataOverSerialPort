#include "YEEP144.h"
#include "YEEP144_DebugUART.h"
#include "YEEP144_HCSR04.h"
#include "YEEP144_I2C.h"
#include "YEEP144_GP2Y0E02B.h"

float usonic[4];
void YEEP144_Ultrasonic1_Callback(uint16_t ticks){
    usonic[0] = YEEP144_Ultrasonic_TickTocm(ticks);
}


int main(void){
	YEEP144_Init();
	YEEP144_DebugUART_Init();
	//Your program initialization code goes here
	YEEP144_Ultrasonic1_Init();    
	
	YEEP144_I2C_Init();
    YEEP144_I2C_MuxSelect(0);

	while(1) {
		//Your program loop code goes here
		float distance_IR0 = YEEP144_GP2Y0E02B_Read();

		YEEP144_Ultrasonic1_Ping();
		HAL_Delay(50);

		float time_run = (float)HAL_GetTick() / 1000.0;
		YEEP144_DebugUART_printf("time,IR0,US1\r\n");
		YEEP144_DebugUART_printf("%f,%f,%f\r\n", time_run, distance_IR0, usonic[0]);
		HAL_Delay(1000);
	}
}
