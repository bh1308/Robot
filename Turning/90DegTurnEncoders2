#include "YEEP144.h"
#include "YEEP144_DebugUART.h"
#include "YEEP144_DCMotor.h"

uint32_t time_start_ms = 0; //Get the initial start time
float CountsPerCM = (298*6) / (4.80f * 3.14159f); //Counts per cm of movement. (298*6) counts per revolution, divided by distance travelled in one revolution. Distance travelled in one revolution of the wheel 48mm*Pi
float DistanceBetweenWheels = 14.5f; //Distance between the wheels in cm
float x = 0.0f;
float y = 0.0f;
float theta = 0.0f;
float thetaDegrees = 0.0f;

int main(void){
	YEEP144_Init();
	YEEP144_DebugUART_Init();
	YEEP144_DCMotor_Init(); 
	YEEP144_Encoder1_Init(); // Left wheel encoder
	YEEP144_Encoder2_Init(); // Right wheel encoder
	time_start_ms = HAL_GetTick();
	int16_t curr_countsLeft = 0;
	int16_t prev_countsLeft = 0;
	int16_t curr_countsRight = 0;
	int16_t prev_countsRight = 0;

while(1) {
	//Your program loop code goes here
if (fabsf(thetaDegrees) >= 90.0f) {
		YEEP144_DCMotor_SetSpeed(DCMOTOR1, 0);
		YEEP144_DCMotor_SetSpeed(DCMOTOR2, 0);
		YEEP144_DCMotor_SetDirection(DCMOTOR1, DCMOTOR_STOP);
		YEEP144_DCMotor_SetDirection(DCMOTOR2, DCMOTOR_STOP);
	}
		else {
		//YEEP144_DCMotor_SetSpeed(DCMOTOR1, 1023);
		//YEEP144_DCMotor_SetSpeed(DCMOTOR2, 2047);
	//	YEEP144_DCMotor_SetDirection(DCMOTOR1, DCMOTOR_CW);
		//YEEP144_DCMotor_SetDirection(DCMOTOR2, DCMOTOR_CW);

		YEEP144_DCMotor_SetSpeed(DCMOTOR1, 1023);
		YEEP144_DCMotor_SetSpeed(DCMOTOR2, 960);
		YEEP144_DCMotor_SetDirection(DCMOTOR1, DCMOTOR_CCW);
		YEEP144_DCMotor_SetDirection(DCMOTOR2, DCMOTOR_CCW);
	}

		uint32_t enc1 = YEEP144_Encoder1_Get();
		uint32_t enc2 = YEEP144_Encoder2_Get();
		uint32_t time_current_ms = HAL_GetTick(); // Check the current time
		uint32_t time_elapsed_ms = (time_current_ms - time_start_ms);
			
			prev_countsLeft = curr_countsLeft;
			curr_countsLeft = enc1;
			int32_t delta1 = (int16_t)(curr_countsLeft - prev_countsLeft);
			float DeltaLeftCM = (float)delta1 / CountsPerCM; // Change in distance travelled by the left wheel in cm

			prev_countsRight = curr_countsRight;
			curr_countsRight = enc2;
			int32_t delta2 = (int16_t)(curr_countsRight - prev_countsRight);
			int32_t deltaRight = -delta2; // Negative as the right encoder counts in the opposite direction to the left encoder counts
			float DeltaRightCM = (float)deltaRight / CountsPerCM; // Change in distance travelled by the right wheel in cm

			float IncrementalRotationAngle = ((DeltaRightCM - DeltaLeftCM) / DistanceBetweenWheels); // Incremental rotation angle of the robot in radians
			float IncrementalDistance = ((DeltaRightCM + DeltaLeftCM) / 2.0f); // Incremental distance travelled by the robot in cm

			x += IncrementalDistance * cosf(theta);
			y += IncrementalDistance * sinf(theta);

			theta += IncrementalRotationAngle;	// Update the robot's orientation angle in Radians
			thetaDegrees = theta * (180.0f / 3.14159f); // Convert theta from radians to degrees
					if(time_elapsed_ms > 1000) { // If more than one second has elapsed
				time_start_ms = HAL_GetTick(); // Reset start time
				YEEP144_DebugUART_printf("Change in X: %.2f cm\tChange in Y: %.2f cm\tAngle: %.2f deg\r\n", x, y, thetaDegrees);
                YEEP144_DebugUART_printf("Left Encoder Counts: %d\tRight Encoder Counts: %d\r\n", curr_countsLeft, curr_countsRight);
                YEEP144_DebugUART_printf("Delta Left: %.2f cm\tDelta Right: %.2f cm\r\n", DeltaLeftCM, DeltaRightCM);
		}
}
}
