#include "YEEP144.h"
#include "YEEP144_DebugUART.h"
#include "YEEP144_I2C.h"
#include "YEEP144_GP2Y0E02B.h"

int main(void) {
    YEEP144_Init();
    YEEP144_DebugUART_Init();
    YEEP144_I2C_Init();

    while(1) {

        // Read first IR sensor
        YEEP144_I2C_MuxSelect(0);
        float distance_IR0 = YEEP144_GP2Y0E02B_Read();

        // Read second IR sensor
        YEEP144_I2C_MuxSelect(1);
        float distance_IR1 = YEEP144_GP2Y0E02B_Read();

        // Print both readings
        YEEP144_DebugUART_printf("IR0: %f cm\r\n", distance_IR0);
        YEEP144_DebugUART_printf("IR1: %f cm\r\n", distance_IR1);

        HAL_Delay(1000);
    }
}
