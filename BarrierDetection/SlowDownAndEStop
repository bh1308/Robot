#include "YEEP144.h"
#include "YEEP144_DebugUART.h"
#include "YEEP144_DCMotor.h"
#include "YEEP144_HCSR04.h"

int main(void){
	YEEP144_Init();
	YEEP144_DebugUART_Init();
	YEEP144_DCMotor_Init();
	YEEP144_Ultrasonic1_Init();  
	
	uint8_t RxData[32] = {0};
	uint16_t RxLen = 0;
	uint8_t emergencyStop = 0;
  	
while(1) {
	YEEP144_Ultrasonic1_Ping();
	float USdistance_cm = ultrasonicTickLen[0] / 58.0f;
		HAL_Delay(50);
		YEEP144_DebugUART_printf("%f\r\n", USdistance_cm);
	
	uint8_t err = HAL_UARTEx_ReceiveToIdle(&huart3, RxData, 32, &RxLen, 10);
	//Your program loop code goes here
(void)err;
		switch(RxData[0]) {
	case ' ': //stop with space
	    emergencyStop = 1;
		YEEP144_DCMotor_SetSpeed(DCMOTOR1, 0);
		YEEP144_DCMotor_SetSpeed(DCMOTOR2, 0);
		YEEP144_DCMotor_SetDirection(DCMOTOR1, DCMOTOR_STOP);
		YEEP144_DCMotor_SetDirection(DCMOTOR2, DCMOTOR_STOP);
default:
break;
		}
		RxData[0] = 0;
        RxLen = 0;

if (emergencyStop == 1) {
    YEEP144_DCMotor_SetSpeed(DCMOTOR1, 0);
    YEEP144_DCMotor_SetSpeed(DCMOTOR2, 0);
    YEEP144_DCMotor_SetDirection(DCMOTOR1, DCMOTOR_STOP);
    YEEP144_DCMotor_SetDirection(DCMOTOR2, DCMOTOR_STOP);
    continue; // Skip the rest of the loop
}
else if (USdistance_cm > 8) { // continue at normal speed
		YEEP144_DCMotor_SetSpeed(DCMOTOR1, 2047);
		YEEP144_DCMotor_SetSpeed(DCMOTOR2, 2047);
		YEEP144_DCMotor_SetDirection(DCMOTOR1, DCMOTOR_CCW);
		YEEP144_DCMotor_SetDirection(DCMOTOR2, DCMOTOR_CW);
		YEEP144_DebugUART_printf("No obstacle detected! Continuing at normal speed");
	}
else if (USdistance_cm > 5 && USdistance_cm <= 8) { // slow down the motors
		YEEP144_DCMotor_SetSpeed(DCMOTOR1, 1024);
		YEEP144_DCMotor_SetSpeed(DCMOTOR2, 1024);
		YEEP144_DCMotor_SetDirection(DCMOTOR1, DCMOTOR_CCW);
		YEEP144_DCMotor_SetDirection(DCMOTOR2, DCMOTOR_CW);
		YEEP144_DebugUART_printf("Obstacle detected! Slowing down motors");
}
else if (USdistance_cm > 0 && USdistance_cm <= 5) {         // stop the motors
		YEEP144_DCMotor_SetSpeed(DCMOTOR1, 0);
		YEEP144_DCMotor_SetSpeed(DCMOTOR2, 0);
		YEEP144_DCMotor_SetDirection(DCMOTOR1, DCMOTOR_STOP);
		YEEP144_DCMotor_SetDirection(DCMOTOR2, DCMOTOR_STOP);
		YEEP144_DebugUART_printf("Obstacle detected! Stopping motors");
}

}
}
